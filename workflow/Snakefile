#############################
# Minimum Snakemake version #
#############################

# Enable setting a minimum Snakemake version supported by the workflow.
from snakemake.utils import min_version

# This workflow specifies the use of conda via the `software-deployment-method`
# parameter that was introduced in Snakemake 8.
# It was tested with version 9.27.0 but a search through the changelog for
# features added in-between did not reveal anything that should affect this
# workflow.
min_version("8.0.0")


###########
# Imports #
###########

import re
from pathlib import Path

from snakemake.utils import validate


##############
# Parameters #
##############

configfile: "config/config.yaml"
validate(config, "schemas/config.yaml")

READS_DIR = config["reads_dir"]
FASTQ_EXTENSION = config["fastq_extension"]
GENOME_NAME = config["genome"]["name"]
TRANSCRIPTOME_NAME = config["transcriptome"]["name"]

# Avoid repeating the genome name if the transcriptome name already contains it
INDEX_NAME = (
  TRANSCRIPTOME_NAME if GENOME_NAME in TRANSCRIPTOME_NAME
  else f"{GENOME_NAME}.{TRANSCRIPTOME_NAME}"
)

# STAR can decompress gzipped reads on the fly
READ_FILES_COMMAND = (
  "--readFilesCommand gzip -cd" if FASTQ_EXTENSION.endswith(".gz") else ""
)


#####################
# Sample resolution #
#####################

def resolve_sample_fastqs(samples, reads_dir, fastq_extension):
  """Map each sample name to the paired FASTQ files of its sample ID.

  Expects files at `{reads_dir}/{batch}/{sample_id}_{mate}.{fastq_extension}`.
  Fails early if a sample name is assigned to more than one sample ID (the
  sample name is the only wildcard in the output paths) or if a file is
  missing.
  """
  sample_fastqs = {}
  sample_sources = {}
  mates = (1, 2)
  for batch, batch_samples in samples.items():
    for sample_id, sample in batch_samples.items():
      if sample in sample_sources:
        raise ValueError(
          f"Sample '{sample}' is assigned to more than one sample ID: "
          f"'{sample_sources[sample]}' and '{batch}/{sample_id}'"
        )
      sample_sources[sample] = f"{batch}/{sample_id}"
      sample_fastqs[sample] = {}
      for mate in mates:
        fastq_path = (Path(reads_dir) / batch /
                      f"{sample_id}_{mate}.{fastq_extension}")
        if not fastq_path.exists():
          raise ValueError(f"FASTQ file not found: {fastq_path}")
        sample_fastqs[sample][mate] = str(fastq_path)
  return sample_fastqs


SAMPLE_FASTQS = resolve_sample_fastqs(
  config["samples"], READS_DIR, FASTQ_EXTENSION
)


########################
# Wildcard constraints #
########################

wildcard_constraints:
  genome = re.escape(GENOME_NAME),
  transcriptome = re.escape(TRANSCRIPTOME_NAME),
  index = re.escape(INDEX_NAME),
  sample = "|".join(re.escape(sample) for sample in SAMPLE_FASTQS),


#########
# Rules #
#########

rule download_genome:
  """Download the genome FASTA."""
  output: genome_fasta = "resources/references/genome/{genome}.fasta.gz"
  params: url = config["genome"]["fasta_url"]
  log: "results/logs/genome_downloading/{genome}.log"
  conda: "envs/download_genome.yaml"
  threads: 1
  resources:
    mem_mb = 512,
    runtime = 30
  shell:
    """
    curl --fail --silent --show-error --location \
      '{params.url}' --output '{output.genome_fasta}' \
      > '{log}' 2>&1
    """


rule download_transcriptome:
  """Download the transcriptome GTF as a coordinate-sorted, bgzipped file.

  The stream is sorted and recompressed on the fly (for tabix/VEP/STAR), so
  the unsorted, non-bgzipped annotation never touches the disk.
  """
  output:
    sorted_transcriptome_gtf =
      "resources/references/transcriptome/{transcriptome}.sorted.gtf.gz",
  params: url = config["transcriptome"]["gtf_url"]
  log: "results/logs/transcriptome_downloading/{transcriptome}.log"
  conda: "envs/download_transcriptome.yaml"
  # Half of the threads for `sort` and half for `bgzip`, since both can be
  # busy at the same time while the sorted stream is being compressed.
  # Must be 2 at minimum due to piping.
  threads: 8
  resources:
    mem_mb = 2000,
    runtime = 30
  shell:
    """
    exec 2> '{log}'
    # Half of the threads for `sort` and half for `bgzip`.
    half_threads=$(( {threads} / 2 ))
    # Comment lines are dropped because sort would scramble them and tabix
    # would choke on them.
    curl --fail --silent --show-error --location '{params.url}' \
      | gzip --decompress --stdout \
      | grep --invert-match '^#' \
      | LC_ALL=C sort --parallel=$half_threads -S 1G -k1,1 -k4,4n -k5,5n \
      | bgzip --threads $half_threads --compress-level 9 --stdout \
      > '{output.sorted_transcriptome_gtf}'
    """


rule decompress_genome:
  """Decompress a gzipped reference file (temporary, as required by STAR)."""
  input: archive = rules.download_genome.output.genome_fasta
  output: reference = temp("resources/references/genome/{genome}.fasta")
  log: "results/logs/genome_decompression/{genome}.log"
  conda: "envs/decompress_genome.yaml"
  threads: 1
  resources:
    mem_mb = 512,
    runtime = 30
  shell:
    """
    gzip --decompress --stdout '{input.archive}' \
      > '{output.reference}' \
      2> '{log}'
    """


# Reuses the shell command, env and resources of `decompress_genome`.
use rule decompress_genome as decompress_transcriptome with:
  input: archive = rules.download_transcriptome.output.sorted_transcriptome_gtf
  output:
    reference = temp("resources/references/transcriptome/{transcriptome}.gtf")
  log: "results/logs/transcriptome_decompression/{transcriptome}.log"


rule index_genome:
  """Build a STAR index of the genome, including annotated splice junctions."""
  input:
    fasta = expand(
      rules.decompress_genome.output.reference, genome=GENOME_NAME
    ),
    gtf = expand(
      rules.decompress_transcriptome.output.reference,
      transcriptome=TRANSCRIPTOME_NAME
    )
  output: index = directory("resources/indices/genome/star/{index}")
  params:
    sjdb_overhang = config["star"]["index"]["sjdb_overhang"],
    extra_args = config["star"]["index"]["extra_args"]
  log: "results/logs/genome_indexing/{index}.log"
  conda: "envs/index_genome.yaml"
  threads: 8
  resources:
    mem_mb = 40000,
    runtime = 120
  shell:
    """
    # STAR ignores TMPDIR, so place its temp files in a directory created by
    # mktemp (which respects TMPDIR). STAR requires --outTmpDir to not exist.
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "$tmp_dir"' EXIT
    STAR \
      --runMode genomeGenerate \
      --runThreadN {threads} \
      --genomeDir '{output.index}' \
      --genomeFastaFiles '{input.fasta}' \
      --sjdbGTFfile '{input.gtf}' \
      --sjdbOverhang {params.sjdb_overhang} \
      --outFileNamePrefix "$tmp_dir/" \
      --outTmpDir "$tmp_dir/star.tmp" \
      {params.extra_args} \
      > '{log}' 2>&1
    """


rule map_reads:
  """Map paired-end reads of one sample to the genome with STAR."""
  input:
    index = rules.index_genome.output.index,
    mate1 = lambda wildcards: SAMPLE_FASTQS[wildcards.sample][1],
    mate2 = lambda wildcards: SAMPLE_FASTQS[wildcards.sample][2]
  output: bam = "results/mapping/genome/star/{sample}.{index}.bam"
  params:
    read_files_command = READ_FILES_COMMAND,
    extra_args = config["star"]["align"]["extra_args"]
  log:
    run = "results/logs/genome_mapping/{sample}.{index}.log",
    # STAR's final summary. If MultiQC is ever introduced, move this to
    # `output` so that it can be requested as an input of the MultiQC rule
    # (log files cannot be used as inputs of other rules).
    final = "results/logs/genome_mapping/{sample}.{index}.Log.final.out"
  conda: "envs/map_reads.yaml"
  threads: 8
  resources:
    mem_mb = 40000,
    runtime = 120
  shell:
    """
    # STAR ignores TMPDIR, so place its temp files in a directory created
    # by mktemp (which respects TMPDIR). STAR requires `--outTmpDir` to not
    # exist.
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "$tmp_dir"' EXIT
    # The read group (`--outSAMattrRGline`) is required such that GATK can
    # set the sample name in the joint VCF for `bcftools`. `ID` and `SM`
    # are both the sample name, which is unique across the workflow and has
    # one FASTQ pair, so one read group per BAM suffices.
    STAR \
      --runThreadN {threads} \
      --genomeDir '{input.index}' \
      --readFilesIn '{input.mate1}' '{input.mate2}' \
      {params.read_files_command} \
      --outSAMattrRGline ID:'{wildcards.sample}' SM:'{wildcards.sample}' \
      --outSAMtype BAM SortedByCoordinate \
      --outBAMcompression 10 \
      --outStd BAM_SortedByCoordinate \
      --outFileNamePrefix "$tmp_dir/" \
      --outTmpDir "$tmp_dir/star.tmp" \
      {params.extra_args} \
      > '{output.bam}' \
      2> '{log.run}'
    cp "$tmp_dir/Log.final.out" '{log.final}'
    """


rule index_bam:
  """Index a coordinate-sorted BAM file."""
  input: bam = rules.map_reads.output.bam
  output: bai = "results/mapping/genome/star/{sample}.{index}.bam.bai"
  log: "results/logs/bam_indexing/{sample}.{index}.log"
  conda: "envs/index_bam.yaml"
  threads: 2
  resources:
    mem_mb = 1000,
    runtime = 30
  shell:
    """
    samtools index \
      -@ $(( {threads} - 1 )) \
      '{input.bam}' '{output.bai}' \
      > '{log}' 2>&1
    """


rule all:
  """Map all samples to the genome and index the resulting BAM files."""
  default_target: True
  input:
    bams = expand(
      rules.map_reads.output.bam, sample=SAMPLE_FASTQS, index=INDEX_NAME
    ),
    bais = expand(
      rules.index_bam.output.bai, sample=SAMPLE_FASTQS, index=INDEX_NAME
    )
